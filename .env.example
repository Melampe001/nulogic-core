# ==============================================================================
# NULOGIC_CORE - Environment Variables Template
# TokyoApps Global Technologies (Enterprise Compliance)
# ==============================================================================

# Entorno de Ejecución (development, staging, production)
NODE_ENV=production
APP_DEBUG=false

# Base de Datos y Cumplimiento
DATABASE_URL=sqlite:///database/nulogic_core.db
GDPR_LFPDPPP_COMPLIANCE=true

# Pasarelas de Pago Híbridas (Stripe / Fiat)
STRIPE_PUBLISHABLE_KEY=pk_live_placeholder
STRIPE_SECRET_KEY=sk_live_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# OKX V5 API Cripto & Automatización Financiera
OKX_API_BASE_URL=https://www.okx.com
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_SIMULATED_TRADING=true
